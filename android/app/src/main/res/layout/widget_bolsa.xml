<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_fondo">
    <TextView android:id="@+id/w_titulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#99F6E4" android:textSize="12sp" android:text="Mi Bolsa" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_l1" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:text="Abre la app" android:maxLines="1" />
    <TextView android:id="@+id/w_l2" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#CBD5E1" android:textSize="13sp" android:text="para ver tu puesto" android:maxLines="2" />
</LinearLayout>
